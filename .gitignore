# Virtual environment
venv/
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Data — keep the directory structure, not the audio
data/librispeech_clean/*.wav
data/degraded/**/*.wav
data/noise_sources/*.wav
_raw_download/

# Generated output (regenerable by re-running the pipeline)
results/*.csv
results/plots/
results/test_mode/
results/.pipeline_checkpoint
logs/*.log

# Scratch
scratch/
backups/

# Distribution
*.egg-info/
dist/
build/

# Node toolchain used only to build the slide deck. package.json is tracked so
# the dependency is recorded; the installed tree is not.
node_modules/

# Deliverables and working notes kept out of version control by choice
CLAUDE.md
Speech_FinalPJT_eval.pdf
report/

# LaTeX build products, in case a report is ever compiled in-tree
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
